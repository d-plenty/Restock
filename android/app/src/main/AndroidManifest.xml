        <!-- Home screen widgets. -->
        <receiver
            android:name=".DealsWidget"
            android:exported="false"
            android:label="Restock deals">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_deals_info" />
        </receiver>
        <receiver
            android:name=".ListWidget"
            android:exported="false"
            android:label="Restock shopping list">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_list_info" />
        </receiver>
        <receiver
            android:name=".QuickWidget"
            android:exported="false"
            android:label="Restock quick actions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 0.7.3: "Check for updates" hands a new Restock release to Android's installer (you tap Install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A short buzz when something is added to the shopping list. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The open-source barcode scanner uses the camera inside the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Approximate location only, to list the nearest Coles, Woolworths and Aldi. Never in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- "Take a photo" (receipts): Android 11+ only lets Restock find the camera app if it says so here.
         Without this, the camera request quietly falls back to the photo library. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
