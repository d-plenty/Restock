{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc"
  ],
  "rules": {
    "no-control-regex": "off",
    "unicorn/no-useless-spread": "off",
    "no-unused-expressions": "off",
    "react/rules-of-hooks": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "android/**",
    "ios/**",
    "node_modules/**",
    "tools/sync-test/out/**"
  ]
}
