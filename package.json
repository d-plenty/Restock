{
  "name": "restock",
  "private": true,
  "version": "0.9.14",
  "type": "module",
  "description": "Restock: a local-first price tracker for supermarkets, bottle shops and chemists in Australia. Works fully on your phone, with no account and no ads. Your own Restock server is optional.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:apk-debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "build:preview": "VITE_PREVIEW=1 vite build --config vite.preview.config.ts",
    "build:server-web": "vite build --config vite.server.config.ts",
    "build:server-core": "vite build --config vite.core.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.3",
    "jsbarcode": "3.12.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "^1.15.2",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "6.2.1",
    "linkedom": "^0.18.12",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "5.1.0"
  }
}
